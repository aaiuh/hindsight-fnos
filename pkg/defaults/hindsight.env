# Hindsight 运行参数（可用任意编辑器修改后重启应用生效）
# 说明：本文件由安装脚本生成，覆盖 main 里的同名默认值

# ── 服务端口 ────────────────────────────────────────────────
HINDSIGHT_API_HOST=0.0.0.0
HINDSIGHT_API_PORT=8888
HINDSIGHT_API_LOG_LEVEL=info
# 管理界面端口：内网直接用浏览器打开 http://<主机IP>:9999
HINDSIGHT_UI_PORT=9999

# ── 语义嵌入与重排 ──────────────────────────────────────────
# onnx = 本地 ONNX 推理，不依赖 torch，也不需要联网
HINDSIGHT_API_EMBEDDINGS_PROVIDER=onnx
# flashrank = 本地 ONNX 重排（模型随包预置）
HINDSIGHT_API_RERANKER_PROVIDER=flashrank

# ── 事实抽取用的 LLM ────────────────────────────────────────
# 默认 none：装完即可启动，但不做事实抽取（只能用 REST 接口与已有数据）。
# 要用起来就改成 openai / ollama / litellm 等，并填好下面三项，然后重启应用。
HINDSIGHT_API_LLM_PROVIDER=none
HINDSIGHT_API_LLM_BASE_URL=
HINDSIGHT_API_LLM_MODEL=
HINDSIGHT_API_LLM_API_KEY=

# ── 模型下载源 ──────────────────────────────────────────────
HF_ENDPOINT=https://hf-mirror.com

# ── 资源占用 ────────────────────────────────────────────────
# 最多使用几个 CPU 核心。安装向导里填的值会写在这里；0 = 不限制。
# 必须写小于本机核数的正整数才生效（等于或大于核数一律按不限制处理）。
# 改完重启应用生效。
