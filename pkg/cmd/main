#!/bin/bash
### Hindsight 飞牛原生版 —— 服务生命周期
### appcenter 以 config/privilege 声明的账号（Hindsight）调用本脚本

: "${TRIM_APPDEST:?TRIM_APPDEST is required}"
: "${TRIM_PKGVAR:?TRIM_PKGVAR is required}"

APP_HOME="${TRIM_PKGVAR}"
RUNTIME="${TRIM_APPDEST}/runtime"
VENV_DIR="${RUNTIME}/venv"
VENV_PY="${VENV_DIR}/bin/hindsight-api"
ENV_FILE="${APP_HOME}/hindsight.env"
PID_FILE="${APP_HOME}/hindsight.pid"
LOG_FILE="${APP_HOME}/hindsight.log"
# 管理界面 = 官方控制台本体，直接监听界面端口（不做任何页面改写）
UI_PORT="${HINDSIGHT_UI_PORT:-9999}"
UI_PID_FILE="${APP_HOME}/ui.pid"
UI_LOG="${APP_HOME}/ui.log"
UI_PY="${RUNTIME}/python/bin/python3"
UI_SRC="${TRIM_APPDEST}/ui/serve.py"
# 官方管理控制台（上游发布物原样放入运行时目录），需要系统已有 Node.js
CP_DIR="${RUNTIME}/control-plane"
CP_PID_FILE="${APP_HOME}/cp.pid"
CP_LOG="${APP_HOME}/cp.log"
NODE_BIN=""
# CPU 配额：生命周期脚本以 root 跑（privilege: run-as=root），服务进程用 setpriv 降到包用户
CAP_CGROUP="/sys/fs/cgroup/hindsight"
SVC_USER="${TRIM_USERNAME:-Hindsight}"

### 按用户选的核数给服务进程设 cgroup CPU 配额。
### 需要 root（本脚本是 root 身份），失败不阻断启动：设不上就按不限制跑，服务照常用。
### cores 语义：正整数且严格小于本机核数才设限；0 / 空 / 非法 / 大于等于核数 一律不限制。
apply_cpu_cap() {
    local pid="$1"
    local cores="${HINDSIGHT_CPU_CORES:-0}"
    [ -n "$pid" ] || return 0
    [ "$(id -u)" = "0" ] || return 0

    case "$cores" in
        ''|*[!0-9]*) return 0 ;;
    esac
    cores=$((10#$cores))
    [ "$cores" -gt 0 ] 2>/dev/null || return 0

    local ncpu
    ncpu=$(nproc 2>/dev/null || echo 0)
    [ "$ncpu" -ge 1 ] 2>/dev/null || return 0
    if [ "$cores" -ge "$ncpu" ]; then
        echo "配置的核数 $cores 不小于本机核数 $ncpu，按不限制运行"
        return 0
    fi

    if ! mkdir -p "$CAP_CGROUP" 2>/dev/null; then
        echo "创建 $CAP_CGROUP 失败，按不限制运行" >&2
        return 0
    fi
    if ! printf '%d 100000\n' "$((cores * 100000))" > "$CAP_CGROUP/cpu.max" 2>/dev/null; then
        echo "写入 $CAP_CGROUP/cpu.max 失败，按不限制运行" >&2
        return 0
    fi
    if printf '%s\n' "$pid" > "$CAP_CGROUP/cgroup.procs" 2>/dev/null; then
        echo "CPU 配额：限制到 ${cores}/${ncpu} 核（pid $pid）"
    else
        echo "把 pid $pid 移入 $CAP_CGROUP 失败，按不限制运行" >&2
    fi
    return 0
}

is_running() {
    [ -f "$PID_FILE" ] || return 1
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null)
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

# 复用系统里已装的 Node.js：应用中心的 Node.js 应用、或 PATH 里的 node。
# 不随包分发 Node，缺了就在界面上提示去装，而不是把 100+ MB 塞给别人。
find_node() {
    local c major
    for c in "${HINDSIGHT_NODE:-}" \
             /var/apps/nodejs_v24/target/bin/node \
             /var/apps/nodejs_v22/target/bin/node \
             /vol1/@appcenter/nodejs_v24/bin/node \
             /vol1/@appcenter/nodejs_v22/bin/node \
             "$(command -v node 2>/dev/null || true)" \
             "$(command -v nodejs 2>/dev/null || true)"; do
        [ -n "$c" ] || continue
        [ -x "$c" ] || continue
        major=$("$c" -e 'process.stdout.write(process.versions.node.split(".")[0])' 2>/dev/null || echo 0)
        [ "${major:-0}" -ge 20 ] 2>/dev/null || continue
        echo "$c"
        return 0
    done
    return 1
}

cp_running() {
    [ -f "$CP_PID_FILE" ] || return 1
    local pid
    pid=$(cat "$CP_PID_FILE" 2>/dev/null)
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

stop_cp() {
    if cp_running; then
        local pid
        pid=$(cat "$CP_PID_FILE")
        pkill -P "$pid" 2>/dev/null || true
        kill "$pid" 2>/dev/null || true
        sleep 2
        pkill -P "$pid" 2>/dev/null || true
        kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$CP_PID_FILE"
    return 0
}

start_cp() {
    if [ ! -f "${CP_DIR}/server.js" ]; then
        echo "未找到管理控制台（运行时包不含 control-plane），管理界面不可用" >&2
        return 1
    fi
    if ! NODE_BIN=$(find_node); then
        echo "未找到 Node.js（需要 20 及以上）——管理界面不可用。" >&2
        echo "在应用中心安装 Node.js 后重启本应用即可，无需重装。" >&2
        return 1
    fi
    stop_cp
    stop_ui
    (
        cd "$CP_DIR" || exit 1
        HOSTNAME=0.0.0.0 \
        PORT="$UI_PORT" \
        NODE_OPTIONS="--dns-result-order=ipv4first" \
        NODE_ENV=production \
        HINDSIGHT_CP_DATAPLANE_API_URL="http://127.0.0.1:${HINDSIGHT_API_PORT}" \
        nohup "$NODE_BIN" server.js >> "$CP_LOG" 2>&1 &
        echo $! > "$CP_PID_FILE"
    )
    local i
    for i in $(seq 1 60); do
        if curl -fsS "http://127.0.0.1:${UI_PORT}/api/health" >/dev/null 2>&1; then
            echo "管理控制台已启动（node $("$NODE_BIN" -v 2>/dev/null)，端口 ${UI_PORT}）"
            return 0
        fi
        cp_running || break
        sleep 1
    done
    echo "管理控制台启动失败，详情见 $CP_LOG" >&2
    tail -5 "$CP_LOG" >&2 2>/dev/null || true
    return 1
}

ui_running() {
    [ -f "$UI_PID_FILE" ] || return 1
    local pid
    pid=$(cat "$UI_PID_FILE" 2>/dev/null)
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

stop_ui() {
    if ui_running; then
        kill "$(cat "$UI_PID_FILE")" 2>/dev/null || true
        sleep 1
        kill -9 "$(cat "$UI_PID_FILE")" 2>/dev/null || true
    fi
    rm -f "$UI_PID_FILE"
}

# 仅在官方控制台起不来时使用：用包内 python 在同一个界面端口给出依赖提示，
# 保证用户点开图标不会看到一个空端口。正常路径下这个服务不会启动。
start_ui() {
    [ -x "$UI_PY" ] || return 0
    [ -f "$UI_SRC" ] || return 0
    stop_ui
    HINDSIGHT_UI_PORT="$UI_PORT" \
    HINDSIGHT_API_PORT="${HINDSIGHT_API_PORT}" \
        nohup "$UI_PY" "$UI_SRC" >> "$UI_LOG" 2>&1 &
    echo $! > "$UI_PID_FILE"
    local i
    for i in $(seq 1 20); do
        curl -fsS "http://127.0.0.1:${UI_PORT}/health" >/dev/null 2>&1 && return 0
        sleep 0.5
    done
    echo "依赖提示页未就绪：$UI_LOG" >&2
    return 0
}

ensure_env_file() {
    [ -f "$ENV_FILE" ] && return 0
    cat > "$ENV_FILE" <<'ENVEOF'
# Hindsight 运行参数（改完重启应用生效）
HINDSIGHT_API_HOST=0.0.0.0
HINDSIGHT_API_PORT=8888
HINDSIGHT_API_LOG_LEVEL=info
HINDSIGHT_API_EMBEDDINGS_PROVIDER=onnx
HINDSIGHT_API_RERANKER_PROVIDER=flashrank
# 事实抽取需要一个大模型。默认 none = 装完就能启动，但暂不抽取记忆。
# 换成 openai / ollama / litellm 等并填好 BASE_URL、MODEL、API_KEY 后重启即可使用。
HINDSIGHT_API_LLM_PROVIDER=none
HINDSIGHT_API_LLM_BASE_URL=
HINDSIGHT_API_LLM_MODEL=
HINDSIGHT_API_LLM_API_KEY=
ENVEOF
    chmod 600 "$ENV_FILE"
}

start_service() {
    if is_running; then
        echo "Hindsight 已在运行 (pid=$(cat "$PID_FILE"))"
        return 0
    fi
    if [ ! -x "$VENV_PY" ]; then
        echo "运行时缺失: $VENV_PY —— 请重新安装本应用" >&2
        return 1
    fi

    mkdir -p "$APP_HOME/tmp" "$APP_HOME/.pg0"
    ensure_env_file

    # ── venv 修复：构建机上的绝对路径在飞牛上不存在，全部改指包内 python ──
    fix_venv() {
        local py base sb lim
        base="${RUNTIME}/python/bin"
        py="$base/python3"
        [ -x "$py" ] || { echo "包内 python 缺失: $py" >&2; return 1; }
        mkdir -p "${VENV_DIR}/bin"
        ln -sfn "$py" "${VENV_DIR}/bin/python"
        ln -sfn python "${VENV_DIR}/bin/python3"
        local ver
        ver=$("$py" -c 'import sys;print("%d.%d"%sys.version_info[:2])' 2>/dev/null || echo "")
        [ -n "$ver" ] && ln -sfn python "${VENV_DIR}/bin/python${ver}"
        if [ -f "${VENV_DIR}/pyvenv.cfg" ]; then
            sed -i "s|^home = .*|home = ${base}|" "${VENV_DIR}/pyvenv.cfg"
        fi
        # 控制台脚本的 shebang 还指着构建机的 venv 路径
        sb="#!${py}"
        lim=${#sb}
        [ "$lim" -le 120 ] || { echo "包路径过长，shebang 会超限: $lim" >&2; return 1; }
        local f
        for f in "${VENV_DIR}"/bin/*; do
            [ -f "$f" ] || continue
            [ -L "$f" ] && continue
            head -c 2 "$f" 2>/dev/null | grep -q '#!' || continue
            sed -i "1s|^#!.*python[0-9.]*$|${sb}|" "$f"
        done
        return 0
    }
    fix_venv || return 1

    # 重排模型：flashrank 只认 <cache_dir>/ms-marco-MiniLM-L-12-v2
    export TMPDIR="$APP_HOME/tmp"
    if [ -d "${RUNTIME}/flashrank/ms-marco-MiniLM-L-12-v2" ] && \
       [ ! -d "${TMPDIR}/ms-marco-MiniLM-L-12-v2" ]; then
        cp -a "${RUNTIME}/flashrank/ms-marco-MiniLM-L-12-v2" "${TMPDIR}/" 2>/dev/null || true
    fi

    # 嵌入式 PostgreSQL：二进制随包，数据在本应用的数据目录
    if [ -d "${RUNTIME}/pg0/installation" ]; then
        rm -rf "${APP_HOME}/.pg0/installation"
        ln -sfn "${RUNTIME}/pg0/installation" "${APP_HOME}/.pg0/installation"
    fi
    # PostgreSQL 只认 0700/0750；备份/恢复后可能被放宽
    if [ -d "${APP_HOME}/.pg0/instances/hindsight/data" ]; then
        chmod go-rwx "${APP_HOME}/.pg0/instances/hindsight/data" 2>/dev/null || true
    fi

    # 模型随包，全离线加载
    export HOME="$APP_HOME"
    export HF_HOME="${RUNTIME}/hf"
    export HF_HUB_OFFLINE=1
    export HF_HUB_DISABLE_XET=1
    export TRANSFORMERS_VERBOSITY=error
    export HINDSIGHT_API_HOST="${HINDSIGHT_API_HOST:-0.0.0.0}"
    export HINDSIGHT_API_PORT="${HINDSIGHT_API_PORT:-8888}"
    export HINDSIGHT_CP_DATAPLANE_API_URL="http://127.0.0.1:${HINDSIGHT_API_PORT}"

    # 用户可在 $ENV_FILE 覆盖任意变量（LLM provider/base/model/key 等）
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a

    echo "启动 Hindsight：$VENV_PY (port=${HINDSIGHT_API_PORT}, user=${SVC_USER})"
    # 切到应用目录：hindsight-api 会往上层目录找 .env，若在别的目录下启动
    # 会误读无关的 .env（甚至因权限报错），所以固定 cwd
    cd "$APP_HOME" || return 1

    # 本脚本以 root 运行（为了设 cgroup CPU 配额），服务进程必须降到包用户，
    # 否则 Python 会带着 root 权限对外提供 REST/MCP 接口。
    local run_uid run_gid
    run_uid=$(id -u "$SVC_USER" 2>/dev/null || true)
    run_gid=$(id -g "$SVC_USER" 2>/dev/null || true)
    if [ -z "$run_uid" ] || [ -z "$run_gid" ]; then
        if [ "$(id -u)" = "0" ]; then
            # 飞牛上以 root 跑却找不到包账号：这是真问题，不能用 root 对外提供接口
            echo "找不到运行账号 $SVC_USER，拒绝以 root 启动服务" >&2
            return 1
        fi
        # 非 root（CI 冒烟测试等）：本来就没有可降权的目标，直接用当前身份启动
        echo "找不到运行账号 $SVC_USER，当前非 root，直接以当前身份启动" >&2
        nohup "$VENV_PY" --host "$HINDSIGHT_API_HOST" --port "$HINDSIGHT_API_PORT" \
            >> "$LOG_FILE" 2>&1 &
        echo $! > "$PID_FILE"
    else
        # setpriv 用 exec 替换自身，所以 $! 就是 python 的真实 PID（runuser 会留在父进程）
        nohup setpriv --reuid="$run_uid" --regid="$run_gid" --init-groups \
            "$VENV_PY" --host "$HINDSIGHT_API_HOST" --port "$HINDSIGHT_API_PORT" \
            >> "$LOG_FILE" 2>&1 &
        echo $! > "$PID_FILE"
    fi

    # 按配置给服务进程设 CPU 配额；失败只告警，不影响启动
    apply_cpu_cap "$(cat "$PID_FILE" 2>/dev/null || true)"

    # 等健康检查通过（最多 180s，首次启动要建库并加载模型）
    for _ in $(seq 1 90); do
        if curl -fsS "http://127.0.0.1:${HINDSIGHT_API_PORT}/health" >/dev/null 2>&1; then
            echo "Hindsight 启动完成"
            # 管理界面优先跑官方控制台；起不来才退到依赖提示页
            start_cp || start_ui
            return 0
        fi
        if ! is_running; then
            echo "Hindsight 启动失败，日志尾部：" >&2
            tail -20 "$LOG_FILE" >&2
            return 1
        fi
        sleep 2
    done
    echo "Hindsight 启动超时（仍在后台运行，日志：$LOG_FILE）" >&2
    return 1
}

stop_service() {
    if ! is_running; then
        echo "Hindsight 未在运行"
        rm -f "$PID_FILE"
        stop_cp
        stop_ui
        return 0
    fi
    local pid
    pid=$(cat "$PID_FILE")
    echo "停止 Hindsight (pid=$pid)"
    kill "$pid" 2>/dev/null
    for _ in $(seq 1 40); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 1
    done
    kill -9 "$pid" 2>/dev/null
    pkill -P "$pid" 2>/dev/null
    rm -f "$PID_FILE"
    stop_cp
    stop_ui

    # 嵌入式 postgres 由 API 托管，异常退出时可能残留
    # 注意：只按本应用的数据目录精确匹配，避免误伤别的实例
    local pgpid
    pgpid=$(pgrep -f "postgres -D ${APP_HOME}/.pg0/instances/hindsight/data" 2>/dev/null || true)
    if [ -n "$pgpid" ]; then
        kill $pgpid 2>/dev/null || true
        sleep 2
        kill -9 $pgpid 2>/dev/null || true
    fi
    return 0
}

case "$1" in
    start)   start_service ;;
    stop)    stop_service ;;
    status)  if is_running; then echo "Hindsight is running"; exit 0; else echo "Hindsight is not running"; exit 3; fi ;;
    *)       exit 1 ;;
esac
